# --- LLM: Google Gemini (free tier) through its OpenAI-compatible endpoint ----------
AGRI_LLM_PROVIDER=openai_compat
AGRI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGRI_LLM_API_KEY=put_your_own_key_here      # from aistudio.google.com -> Get API key
AGRI_LLM_MODEL=gemini-3.5-flash-lite        # names change over time; if you get 404, list models (see README)
AGRI_LLM_TIMEOUT_S=60

# --- Alternatives -------------------------------------------------------------------
# Anthropic:  AGRI_LLM_PROVIDER=anthropic  AGRI_LLM_MODEL=claude-haiku-4-5-20251001
# Local:      AGRI_LLM_PROVIDER=openai_compat  AGRI_LLM_BASE_URL=http://localhost:11434/v1  AGRI_LLM_MODEL=qwen2.5:3b-instruct

# --- Embeddings ---------------------------------------------------------------------
AGRI_EMBEDDING_BACKEND=sentence_transformers
AGRI_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Service ------------------------------------------------------------------------
AGRI_API_KEY=change-me
AGRI_MIN_SIMILARITY=0.78                    # calibrate: python -m agri_rag.evaluation.run --retrieval-only

# --- Weather (automatic from farm location; the app can still send its own values) ----
AGRI_WEATHER_ENABLED=true
